# ─── Gmail credentials ────────────────────────────────────────────────────────
# Your Gmail address (the account you send FROM)
GMAIL_USER=gbironsolution@gmail.com

# Gmail App Password — NOT your normal Gmail password.
# Steps to create one:
#   1. Go to myaccount.google.com → Security
#   2. Enable 2-Step Verification (required)
#   3. Search "App Passwords" in the search bar
#   4. Create a new App Password → select "Mail" + "Other" → name it "GB Iron Server"
#   5. Copy the 16-character password and paste it below (no spaces)
GMAIL_PASS=your_16_char_app_password_here

# ─── Where to receive leads ───────────────────────────────────────────────────
# Email address that receives the new estimate notifications.
# Can be the same as GMAIL_USER, or a different address (e.g. work email).
NOTIFY_EMAIL=gbironsolution@gmail.com

# ─── Server port (optional, defaults to 3000) ────────────────────────────────
PORT=3000
